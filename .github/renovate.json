{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "includePaths": [
    "packages.yaml"
  ],
  "ignoreUnstable": false,
  "separateMinorPatch": true,
  "separateMultipleMajor": true,
  "separateMultipleMinor": true,
  "customManagers": [
    {
      "customType": "jsonata",
      "fileFormat": "yaml",
      "managerFilePatterns": [
        "/^packages.yaml$/"
      ],
      "matchStrings": [
        "packages.{\"depName\": repo, \"currentValue\": version}"
      ],
      "datasourceTemplate": "github-releases"
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": [
        "mickem/nscp"
      ],
      "automerge": false,
      "prConcurrentLimit": 0
    }
  ],
  "versioning": "loose"
}
